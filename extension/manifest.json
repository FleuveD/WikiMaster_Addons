{
  "manifest_version": 3,
  "name": "WikiMaster Addons",
  "version": "1.1.2",
  "description": "Quality of Life addons to get a better experience in WikiMaster",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.wikimaster.com/*",
    "*://*.wiki-masters.com/*",
    "*://wiki-masters.com/*",
    "*://localhost/*"
  ],
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/wikimaster.webp"
      ],
      "matches": [
        "*://*.wikimaster.com/*",
        "*://*.wiki-masters.com/*",
        "*://wiki-masters.com/*",
        "*://localhost/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.wikimaster.com/*",
        "*://*.wiki-masters.com/*",
        "*://wiki-masters.com/*",
        "*://localhost/*"
      ],
      "js": [
        "content_script.js"
      ]
    },
    {
      "matches": [
        "*://*.wikimaster.com/*",
        "*://*.wiki-masters.com/*",
        "*://wiki-masters.com/*",
        "*://localhost/*"
      ],
      "js": [
        "volume_hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}